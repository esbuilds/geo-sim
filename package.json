{
  "name": "geo-sim",
  "version": "0.0.1",
  "description": "A controlled RAG-injection harness that feeds two content variants to an LLM as context for the same query and records which one gets cited.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "geo-sim": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "examples"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./harness": {
      "types": "./dist/harness/run.d.ts",
      "import": "./dist/harness/run.js"
    },
    "./stats": {
      "types": "./dist/stats/analyze.d.ts",
      "import": "./dist/stats/analyze.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "manual:anthropic": "tsx scripts/manual-test-anthropic.ts",
    "geo-sim": "tsx src/cli/index.ts",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@google/genai": "^1.0.0",
    "better-sqlite3": "^11.7.0",
    "commander": "^13.0.0",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.0"
  }
}
